[remap]

importer="texture"
type="StreamTexture"
path.s3tc="res://FunnelTitan/ships/sprites/dealer-charybdis-m.s3tc.stex"
path.etc2="res://FunnelTitan/ships/sprites/dealer-charybdis-m.etc2.stex"
metadata={
"imported_formats": [ "s3tc", "etc2" ],
"vram_texture": true
}

[deps]

source_file="res://FunnelTitan/ships/sprites/dealer-charybdis-m.png"
dest_files=[ "res://FunnelTitan/ships/sprites/dealer-charybdis-m.s3tc.stex", "res://FunnelTitan/ships/sprites/dealer-charybdis-m.etc2.stex" ]

[params]

compress/mode=2
compress/lossy_quality=0.95
compress/hdr_mode=0
compress/bptc_ldr=0
compress/normal_map=0
flags/repeat=0
flags/filter=true
flags/mipmaps=false
flags/anisotropic=false
flags/srgb=2
process/fix_alpha_border=true
process/premult_alpha=false
process/HDR_as_SRGB=false
process/invert_color=false
process/normal_map_invert_y=false
stream=1
size_limit=1536
detect_3d=true
svg/scale=1.0
